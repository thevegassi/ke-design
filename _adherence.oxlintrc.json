{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/brandbook/**",
              "components/channel/**",
              "components/community/**",
              "components/deck/**",
              "components/icons/**",
              "components/social/**",
              "slides/**",
              "ui_kits/brandbook/**",
              "ui_kits/social/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Nunito Sans|Manrope|Inter))/i]",
        "message": "Font not provided by the design system. Available: Nunito Sans, Manrope, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar28'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|key|ref|className|style|children)$/]",
        "message": "<Avatar28> doesn't accept that prop. Declared props: image."
      },
      {
        "selector": "JSXOpeningElement[name.name='AvatarsSmall'] > JSXAttribute > JSXIdentifier[name!=/^(?:images|size|overlap|key|ref|className|style|children)$/]",
        "message": "<AvatarsSmall> doesn't accept that prop. Declared props: images, size, overlap."
